{
  "name": "dsh-rampart",
  "version": "0.2.0",
  "description": "Memory and CPU guard for DeepSeek Harness: reads free physical/commit memory and whole-tree CPU, grades pressure normal/warn/critical with hysteresis, puts the host at below-normal priority, and refuses heavy tools (pwsh/bash/workflow/subagent) before the machine thrashes. Ships a composer readout showing how much of the machine DSH itself is using.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/pressure.js",
    "lib/guardian.js",
    "lib/win32.js",
    "lib/config.js",
    "lib/tree-stats.js",
    "lib/host-api.js",
    "lib/gc.js",
    "lib/types/**/*.d.ts",
    "client/source.js",
    "cordis.patch.yml",
    "scripts/launch.mjs",
    "scripts/launcher.mjs",
    "dsh-guarded.cmd",
    "assets/icon-180.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "resource",
    "memory",
    "cpu",
    "pressure",
    "guard",
    "oom",
    "windows"
  ],
  "author": {
    "name": "tataCrayon"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tataCrayon/dsh-rampart.git"
  },
  "homepage": "https://github.com/tataCrayon/dsh-rampart#readme",
  "bugs": {
    "url": "https://github.com/tataCrayon/dsh-rampart/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "node scripts/verify-reversible.mjs && node scripts/verify-cap.mjs && node scripts/verify-launcher-job.mjs",
    "verify:profile": "node scripts/verify-profile.mjs",
    "verify:pill": "node scripts/verify-desktop-pill.mjs",
    "verify:degrade": "node scripts/verify-degrade.mjs",
    "bench": "node scripts/bench.mjs",
    "soak": "node --expose-gc scripts/soak.mjs",
    "preview": "node scripts/preview-panel.mjs",
    "launch": "node scripts/launch.mjs",
    "prepublishOnly": "npm run build:client && npm test && npm run soak"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "icon": "./assets/icon-180.png"
}
